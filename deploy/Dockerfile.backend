# 后端镜像：多阶段构建（Maven JDK17 编译 → JRE17 运行）
# 构建上下文 = 仓库根（compose 里 context: ..），因 pom 为父子结构
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src
# 阿里云 Maven 镜像：国内/阿里云 ECS 构建加速（实测从 ~50KB/s 提升到内网带宽）
COPY deploy/maven-settings.xml /root/.m2/settings.xml
# 先拷 pom 拉依赖（利用层缓存：依赖不变则不重下）
COPY pom.xml .
COPY lab-chat-backend/pom.xml lab-chat-backend/
# 预算依赖只为加速后续层，不能让它拖住整个发布：此步曾无超时挂死（Maven 下载无响应，
# 5 分钟无输出、docker 构建整体卡住）。这里用 timeout 封顶，超时即跳过——
# 下一步 package 会按需下载，最坏只是慢一点，不会挂死。
RUN timeout 240 mvn -q -B -pl lab-chat-backend -am dependency:go-offline \
    || echo "go-offline 超时或失败，跳过预下载（package 阶段会按需拉取）"
COPY lab-chat-backend/src lab-chat-backend/src
RUN timeout 900 mvn -q -B -pl lab-chat-backend -am package -DskipTests

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /src/lab-chat-backend/target/*.jar app.jar
# 2C2G 画像：堆 1g 上限，元空间/直接内存留余量给 Netty SSE
ENV JAVA_OPTS="-Xms512m -Xmx1g -XX:MaxMetaspaceSize=256m"
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
