# ============================================================
# 劳小司部署环境变量模板：cp env.template .env 后填真实值
# ★ .env 已在 .gitignore，禁止提交；AI 部署时禁止把真实值回显到日志/对话
# 所有变量与 application.yml 的 ${VAR:default} 占位一一对应（改密钥不改代码）
# ============================================================

# ---------- PostgreSQL（compose 内 postgres 服务自动消费前三项建库） ----------
PG_DB=lab_legal_kb
PG_USER=postgres
PG_PASSWORD=CHANGE_ME_pg_strong_pwd
# 后端连接地址：compose 内由 docker-compose.yml 覆盖为容器名，此处仅宿主直连调试用
PG_HOST=127.0.0.1
PG_PORT=5432

# ---------- Redis（会话/配额/锁 纯缓存） ----------
# 云 Redis（阿里云 Tair 等）填账号；自建/本地 Redis 留空（空值=仅密码 AUTH）
REDIS_USERNAME=
REDIS_PASSWORD=CHANGE_ME_redis_strong_pwd
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------- 模型密钥（yml 默认值是开发 Key，生产必须替换为自己的） ----------
# DeepSeek：主路线/联网搜索/视觉（web-search.llm + providers.deepseek）
DEEPSEEK_API_KEY=CHANGE_ME_deepseek_key
# 百炼 DashScope：embedding + rerank + 备用 VL（compatible-mode 普通 Key）
DASHSCOPE_API_KEY=CHANGE_ME_dashscope_key
# providers 里 deepseek 端点复用（与 DEEPSEEK_API_KEY 同值即可）
AI_API_KEY=CHANGE_ME_deepseek_key

# ---------- 阿里云短信认证（dypnsapi 个人版；sms-provider=aliyun 时生效） ----------
ALIYUN_SMS_AK=CHANGE_ME_sms_ak
ALIYUN_SMS_SK=CHANGE_ME_sms_sk
ALIYUN_SMS_SIGN=CHANGE_ME_签名名
ALIYUN_SMS_TEMPLATE=CHANGE_ME_模板号

# ---------- 安全 ----------
# JWT 签名密钥：生产必须换长随机串（泄漏=可伪造任意用户 token）
JWT_SECRET=CHANGE_ME_random_64chars
# 首发管理员（通道 A，推荐：零预置口令）：填已注册用户名，启动时提权 ADMIN；
#   首发完成后删除本行（幂等但违反最小权限）；与 db/seed-admin.sql 预设种子二选一
BOOTSTRAP_ADMIN=
