# 劳小司 nginx 站点模板（nginx 官方镜像 envsubst 渲染 ${API_UPSTREAM}）
#
# ============ 域名口径（2026-09-29 起）============
#   laoxiaosi.noctisblue.com   本应用（劳小司）的唯一规范地址，TLS 由 Let's Encrypt 提供
#   noctisblue.com / www       HTTPS 301 跳子域名；顶级域名保留给"所有项目展示首页"，
#                              以后做展示页时只需替换下面第 3 个 server 块的内容
#   其它 Host（含直接用 IP 访问）HTTP 统一 301 到子域名 —— 证书只覆盖域名不含 IP，
#                              这样旧 IP 链接不会撞上证书名不匹配的拦截页
#
# ⚠ 证书从宿主机目录只读挂载进容器：/etc/nginx/certs（acme.sh 安装，见 runbook）
#   目录为空时 nginx 会启动失败（ssl_certificate 不存在），发布前先确认证书就位。

# ---------- 1) HTTP：统一 301 到 HTTPS 规范域名 ----------
server {
    listen 80 default_server;
    server_name _;
    return 301 https://laoxiaosi.noctisblue.com$request_uri;
}

# ---------- 2) HTTPS 主站：劳小司（子域名）----------
server {
    listen 443 ssl;
    http2 on;
    server_name laoxiaosi.noctisblue.com;

    ssl_certificate     /etc/nginx/certs/noctisblue.crt;
    ssl_certificate_key /etc/nginx/certs/noctisblue.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    # HSTS：让浏览器记住"只用 HTTPS"（1 年）。确认所有子域名都上 HTTPS 后再考虑 includeSubDomains
    add_header Strict-Transport-Security "max-age=31536000" always;

    root /usr/share/nginx/html;
    index index.html;

    # 附件上传单文件 100MB（对标 DeepSeek）+ multipart 边界余量
    client_max_body_size 110m;

    # ============ API 反代白名单（部署契约：新增后端前缀必须同步本正则） ============
    # 当前前缀：chat session law-article tools auth admin stats
    # 漏配症状：POST 404/415；GET 被 SPA fallback 以 200 返回 index.html → 前端把 HTML 当 JSON 解析（NaN/undefined 静默上屏）
    location ~ ^/(chat|session|law-article|tools|auth|admin|stats)/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # ★ 关闭 API 访问日志（P0 安全整改）：默认日志格式记录完整 request line，
        #   而历史上 token 与咨询原文都拼在 URL 上，会连人带内容一起落到 access.log。
        #   前端现已改为 POST + 请求头/请求体传参（URL 里不再有敏感参数），这里再关一层，
        #   确保任何老客户端或第三方调用也无法把内容写进磁盘日志。
        #   如需排查 API 访问，请在 http 层自定义 log_format 只用 $uri（不带 $args）。
        access_log off;
        # SSE 三件套：关缓冲 + 关缓存 + 长超时——缺一则流式回答在生产变整包下发
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # 静态资源长缓存（头像/构建产物带哈希）
    location /avatars/ { expires 30d; add_header Cache-Control "public"; }
    location /assets/  { expires 30d; add_header Cache-Control "public,immutable"; }

    # SPA fallback：非 API 路径一律回 index.html（vue-router history 模式）
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ---------- 3) HTTPS 通用域名：暂跳子域名（未来展示首页在此替换）----------
server {
    listen 443 ssl;
    http2 on;
    server_name noctisblue.com www.noctisblue.com;

    ssl_certificate     /etc/nginx/certs/noctisblue.crt;
    ssl_certificate_key /etc/nginx/certs/noctisblue.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # 顶级域名目前没有独立内容：先整站跳到劳小司。
    # 以后要做"项目展示首页"时，把下面这行 return 换成 root/index + location /
    #（或把 DNS 指到另一台机器/另一个容器），其余不用动。
    return 301 https://laoxiaosi.noctisblue.com$request_uri;
}
