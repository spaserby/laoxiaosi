<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        backend 模块（day2-day6 合并演示）
        职责：SSE 流式聊天 + 停止生成 + Redis 会话记忆持久化（day2）
             与 Function Calling 工具调用（day3 + day4）
        功能增量：
            day2 - 新增 memory 包：MessageRecord / ChatMemoryProperties / RedisChatMemory
            day2 - ChatService 注入 Spring AI ChatMemory 接口，记忆存入 Redis
            day2 - 新增 Redisson 依赖与 Redis 连接配置
            day3 - 新增 tool 包：CommonTools（@Tool 注解）注册 getCurrentTime / calculate 两个通用工具
            day3 - AiConfig 构建 ChatClient 时通过 defaultTools 全局挂载通用工具
            day3 - 新增 tool/LegalTools：经济补偿金/加班费/诉讼时效/诉讼费 4 个法律工具（Function Calling 扩展）
            day3 - ChatService 通过 .tools(legalTools) 按需挂载领域工具（与全局工具合并生效）
            day4 - 新增 rag 包：法律条文向量化导入 + Top-K 检索增强（RAG）
            day4 - 向量模型 qwen3.7-text-embedding，向量库 Redis（RediSearch 向量检索）
            day5 - 新增 model 包：ModelRouteProperties/ModelRegistry/ModelRouter，配置驱动五路模型
            day5 - DeepSeek flash/v4-pro + MaaS deepseek-flash/deepseek-v4-pro/qwen3.8-max，关键词路由 + fallback
            day5 - 删除 AiConfig：模型客户端由 ModelRegistry 运行时构建，加模型只改 yml
            day5 - 路由升级三级级联：keyword 硬规则 → semantic 向量快筛 → llm 结构化分类（ChainModelRouter 编排，层可配置启停）
            day6 - 知识库 MySQL 化：law_article 底账表（JPA 只读）+ 导入管道（MD5 增量：新增/变更/删除三态同步）
            day6 - 向量文档改用确定性 ID（law:article:{id}），支持条文修改后精准重导入；删除硬编码语料 LawArticles
            day7 - 检索工具化（Agentic RAG）：searchLaw 工具由模型自主决定是否/如何/几次检索，下线 day4 前置检索拼接
            day7 - 路线差异化工具预算（RoutedClient + route-tools 配置）：cheap 无检索工具，legal 全量高预算
            day7 - 检索预算经 ToolContext 注入（ReAct 循环停止条件），架构从 Workflow 跨入 Agent
            day8 - 框架升级：Spring Boot 3.2.5→3.5.11 / Spring AI 1.0.0→1.1.7 / Redisson 3.50 / SCA 2025.1
            day8 - 联网搜索（LLM-as-Search-Tool）：webSearch 工具内部直调百炼 qwen 联网子模型
                   （enable_search + 检索员提示词软约束官方来源），仅 legal/fallback 路线挂载；
                   曾接入 Spring AI Alibaba 扩展的 Tavily（域名白名单硬过滤），因价格与国内可用性下线
            day9 - 确定性安全层（借鉴智慧问诊方案"不让 LLM 自己看守自己"）：SafetyGuard 纯规则引擎
                   四道关卡：拒答拦截/紧急置顶/高风险检索落空提示/免责声明强制附加
            day10 - grounded-ReAct：legal 路线强制检索打底（进模型前必检，堵住模型跳检幻觉）
            day11 - 评估门禁：金标集（安全层/关键词路由层离线断言 + 端到端链路可选评估，mvn test 默认只跑离线层）
        依赖：Redis（缓存/分布式锁/配额）、PostgreSQL + pgvector（底账/向量，day23 起）
        启动：mvn spring-boot:run -pl lab-chat-backend
        访问：http://localhost:8082（内置聊天页面：输入框 + 发送 + 停止，static/index.html）
             或 curl 测试 http://localhost:8082/chat/stream?sessionId=xx&userMessage=xx
    -->
    <parent>
        <groupId>com.law.assistant</groupId>
        <artifactId>legal-assistant</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>lab-chat-backend</artifactId>
    <name>backend</name>
    <description>聊天演示：SSE 流式 + 停止生成 + Redis 会话记忆 + 工具调用</description>

    <dependencies>
        <!--
            Spring AI OpenAI 兼容 Starter：
            阿里云 MaaS Token 套餐走 OpenAI 兼容协议，通过 spring.ai.openai.base-url
            指向 https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode 即可接入
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Spring AI Client Chat：ChatClient（流式对话客户端） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>

        <!-- Spring Boot WebFlux：支持 Flux<ServerSentEvent> 流式 SSE -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!--
            保留 Tomcat 让应用运行在 Servlet 栈（而非 Netty），
            响应式 Controller（Flux SSE）仍正常工作。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
        </dependency>

        <!-- Redisson：Redis 客户端，用于实现 ChatMemory 会话记忆持久化（day2 增量） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>

        <!--
            day23 存储层迁移：MyBatis + PostgreSQL 取代 JPA + MySQL。
            底账/用户/会话记忆/同步指纹全落 PG；MyBatis 注解 Mapper 单源 SQL。
            建库建表脚本见 scripts/pg-schema.sql
        -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.4</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            day23：Spring AI PgVectorStore Starter（取代 Redis 向量库）：
            向量 + HNSW 索引落 PG vector_store 表（pgvector 扩展），
            metadata 存 JSONB 不再丢失（Redis 向量库时代的老坑根除）。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!-- day11：评估门禁（金标集回归测试，离线断言默认跑；端到端链路评估 -Deval.e2e=true 手动触发） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.law.backend.BackendApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
